{
  "rulebook_version": 1,
  "name": "project-rules",
  "version": "1.0.0",
  "description": "Remindly project rules — expo install wrapper and destructive git protection.",
  "author": "project",
  "allowed_commands": [
    "npm",
    "yarn",
    "pnpm",
    "bun",
    "git"
  ],
  "rules": [
    {
      "name": "block-npm-install",
      "command": "npm",
      "block_args": ["install"],
      "reason": "Use `bunx expo install <package>` instead."
    },
    {
      "name": "block-yarn-add",
      "command": "yarn",
      "block_args": ["add"],
      "reason": "Use `bunx expo install <package>` instead."
    },
    {
      "name": "block-pnpm-add",
      "command": "pnpm",
      "block_args": ["add"],
      "reason": "Use `bunx expo install <package>` instead."
    },
    {
      "name": "block-bun-add",
      "command": "bun",
      "block_args": ["add"],
      "reason": "Use `bunx expo install <package>` instead."
    },
    {
      "name": "block-git-reset-hard",
      "command": "git",
      "subcommand": "reset",
      "block_args": ["--hard"],
      "reason": "Destructive command. Stash or commit changes first."
    },
    {
      "name": "block-git-push-force",
      "command": "git",
      "subcommand": "push",
      "block_args": ["--force"],
      "reason": "Use `--force-with-lease` to prevent overwriting others' work."
    },
    {
      "name": "block-git-clean",
      "command": "git",
      "subcommand": "clean",
      "block_args": ["-f"],
      "reason": "Destructive command. Removes untracked files permanently."
    },
    {
      "name": "block-git-checkout-dot",
      "command": "git",
      "subcommand": "checkout",
      "block_args": ["."],
      "reason": "Destructive command. Discards all working tree changes."
    },
    {
      "name": "block-git-restore-dot",
      "command": "git",
      "subcommand": "restore",
      "block_args": ["."],
      "reason": "Destructive command. Discards all working tree changes."
    }
  ],
  "tests": [
    {
      "command": "npm install react-native-maps",
      "expect": "blocked",
      "rule": "block-npm-install"
    },
    {
      "command": "npm install",
      "expect": "blocked",
      "rule": "block-npm-install"
    },
    {
      "command": "npm run build",
      "expect": "allowed"
    },
    {
      "command": "yarn add react-native-maps",
      "expect": "blocked",
      "rule": "block-yarn-add"
    },
    {
      "command": "pnpm add zustand",
      "expect": "blocked",
      "rule": "block-pnpm-add"
    },
    {
      "command": "bun add expo-camera",
      "expect": "blocked",
      "rule": "block-bun-add"
    },
    {
      "command": "git reset --hard HEAD~1",
      "expect": "blocked",
      "rule": "block-git-reset-hard"
    },
    {
      "command": "git reset HEAD~1",
      "expect": "allowed"
    },
    {
      "command": "git push --force origin main",
      "expect": "blocked",
      "rule": "block-git-push-force"
    },
    {
      "command": "git push --force-with-lease origin main",
      "expect": "allowed"
    },
    {
      "command": "git clean -fd",
      "expect": "blocked",
      "rule": "block-git-clean"
    },
    {
      "command": "git checkout .",
      "expect": "blocked",
      "rule": "block-git-checkout-dot"
    },
    {
      "command": "git checkout main",
      "expect": "allowed"
    },
    {
      "command": "git restore .",
      "expect": "blocked",
      "rule": "block-git-restore-dot"
    },
    {
      "command": "git restore src/App.tsx",
      "expect": "allowed"
    }
  ]
}
